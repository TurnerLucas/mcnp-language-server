{
	"comments": {
		"lineComment": "c "
	},
	"brackets": [
		["(", ")"]
	],
	"autoClosingPairs": [
		{ "open": "(", "close": ")" }
	],
	"surroundingPairs": [
		["(", ")"]
	],
	"wordPattern": "[A-Za-z0-9_.:/]+",
	"onEnterRules": [
		{
			"beforeText": "&\\s*$",
			"action": { "indent": "indent" }
		}
	]
}
