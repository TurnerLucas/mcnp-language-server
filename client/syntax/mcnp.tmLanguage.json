{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "MCNP",
	"scopeName": "source.mcnp",
	"patterns": [
		{
			"begin": "^(.*)$",
			"beginCaptures": {
				"1": {
					"name": "entity.name.section.title.mcnp"
				}
			},
			"while": "^",
			"patterns": [
				{
					"include": "#statements"
				}
			]
		}
	],
	"repository": {
		"statements": {
			"patterns": [
				{
					"include": "#full_line_comment"
				},
				{
					"include": "#statement_begin"
				},
				{
					"include": "#statement_extension"
				}
			]
		},
		"statement_begin": {
			"patterns": [
				{
					"include": "#cell_card"
				},
				{
					"include": "#surface_card"
				},
				{
					"include": "#data_card"
				}
			]
		},
		"data_card": {
			"patterns": [
				{
					"include": "#source_data_card"
				},
				{
					"include": "#material_data_card"
				},
				{
					"include": "#tally_data_card"
				},
				{
					"include": "#problem_data_card"
				},
				{
					"include": "#variance_reduction_data_card"
				},
				{
					"include": "#geometry_data_card"
				},
				{
					"include": "#generic_data_card"
				}
			]
		},
		"card_body": {
			"patterns": [
				{
					"include": "#inline_comment"
				},
				{
					"include": "#continuation"
				},
				{
					"include": "#geometry_operator"
				},
				{
					"include": "#distribution"
				},
				{
					"include": "#shorthand"
				},
				{
					"include": "#number"
				},
				{
					"include": "#nuclide_library"
				},
				{
					"include": "#argument"
				}
			]
		},
		"full_line_comment": {
			"patterns": [
				{
					"name": "comment.line.c.mcnp",
					"match": "^[ ]{0,4}([cC])(\\s.*)?$"
				}
			]
		},
		"statement_extension": {
			"patterns": [
				{
					"begin": "^",
					"end": "\n",
					"contentName": "meta.card.continuation.mcnp",
					"patterns": [
						{
							"include": "#card_body"
						}
					]
				}
			]
		},
		"cell_card": {
			"patterns": [
				{
					"begin": "^ {0,4}(\\d+)\\s+(?:(0)|(\\d+)\\s+([-+]?(?:\\d+\\.?\\d*|\\.\\d+)(?:[eE][-+]?\\d+)?))",
					"end": "\n",
					"contentName": "meta.card.cell.mcnp",
					"beginCaptures": {
						"1": {
							"name": "entity.name.function.cell.mcnp"
						},
						"2": {
							"name": "keyword.control.void.mcnp"
						},
						"3": {
							"name": "entity.name.type.material.mcnp"
						},
						"4": {
							"name": "constant.numeric.density.mcnp"
						}
					},
					"patterns": [
						{
							"include": "#card_body"
						}
					]
				}
			]
		},
		"surface_card": {
			"patterns": [
				{
					"begin": "^ {0,4}([*+]?)(\\d+)(?:\\s+(\\d+))?\\s+([[:alpha:]][[:alnum:]/]*)",
					"end": "\n",
					"contentName": "meta.card.surface.mcnp",
					"beginCaptures": {
						"1": {
							"name": "keyword.operator.modifier.mcnp"
						},
						"2": {
							"name": "entity.name.function.surface.mcnp"
						},
						"3": {
							"name": "entity.name.type.transform.mcnp"
						},
						"4": {
							"name": "support.function.surface.mcnp"
						}
					},
					"patterns": [
						{
							"include": "#card_body"
						}
					]
				}
			]
		},
		"source_data_card": {
			"patterns": [
				{
					"begin": "(?i)^ {0,4}(sdef|ssw|ssr|kcode|ksrc|hsrc)(?![[:alnum:]])",
					"end": "\n",
					"contentName": "meta.card.source.mcnp",
					"beginCaptures": {
						"1": {
							"name": "keyword.control.source.mcnp"
						}
					},
					"patterns": [
						{
							"include": "#card_body"
						}
					]
				},
				{
					"begin": "(?i)^ {0,4}(si|sp|sb|ds|sc)(\\d+)(?![[:alnum:]])",
					"end": "\n",
					"contentName": "meta.card.source.mcnp",
					"beginCaptures": {
						"1": {
							"name": "keyword.control.source.mcnp"
						},
						"2": {
							"name": "entity.name.function.distribution.mcnp"
						}
					},
					"patterns": [
						{
							"include": "#card_body"
						}
					]
				}
			]
		},
		"material_data_card": {
			"patterns": [
				{
					"begin": "(?i)^ {0,4}(mpn|mt|mx|xs|m)(\\d+)(?![[:alnum:]])",
					"end": "\n",
					"contentName": "meta.card.material.mcnp",
					"beginCaptures": {
						"1": {
							"name": "keyword.control.material.mcnp"
						},
						"2": {
							"name": "entity.name.function.material.mcnp"
						}
					},
					"patterns": [
						{
							"include": "#card_body"
						}
					]
				},
				{
					"begin": "(?i)^ {0,4}(drxs|totnu|nonu|awtab|void|pikmt|mgopt)(?![[:alnum:]])",
					"end": "\n",
					"contentName": "meta.card.material.mcnp",
					"beginCaptures": {
						"1": {
							"name": "keyword.control.material.mcnp"
						}
					},
					"patterns": [
						{
							"include": "#card_body"
						}
					]
				}
			]
		},
		"tally_data_card": {
			"patterns": [
				{
					"include": "#f5_tally"
				},
				{
					"include": "#fmesh_tally"
				},
				{
					"include": "#tally_comment"
				},
				{
					"include": "#generic_tally"
				},
				{
					"include": "#tally_modifier"
				}
			]
		},
		"f5_tally": {
			"patterns": [
				{
					"begin": "(?i)^ {0,4}([*+]?)((?:fip|fir|fic|f)\\d*5a?)(:[[:alpha:]]+(?:,[[:alpha:]]+)*)",
					"end": "\n",
					"contentName": "meta.card.tally.detector.mcnp",
					"beginCaptures": {
						"1": {
							"name": "keyword.operator.modifier.mcnp"
						},
						"2": {
							"name": "keyword.control.tally.mcnp"
						},
						"3": {
							"name": "entity.name.tag.particle.mcnp"
						}
					},
					"patterns": [
						{
							"include": "#card_body"
						}
					]
				}
			]
		},
		"fmesh_tally": {
			"patterns": [
				{
					"begin": "(?i)^ {0,4}([*]?)(fmesh\\d*4)(:[[:alpha:]]+(?:,[[:alpha:]]+)*)",
					"end": "\n",
					"contentName": "meta.card.tally.fmesh.mcnp",
					"beginCaptures": {
						"1": {
							"name": "keyword.operator.modifier.mcnp"
						},
						"2": {
							"name": "keyword.control.tally.mcnp"
						},
						"3": {
							"name": "entity.name.tag.particle.mcnp"
						}
					},
					"patterns": [
						{
							"include": "#card_body"
						}
					]
				}
			]
		},
		"tally_comment": {
			"patterns": [
				{
					"begin": "(?i)^ {0,4}(fc\\d+)(?![[:alnum:]])",
					"end": "\n",
					"contentName": "meta.card.tally.comment.mcnp",
					"beginCaptures": {
						"1": {
							"name": "keyword.control.tally.mcnp"
						}
					}
				}
			]
		},
		"generic_tally": {
			"patterns": [
				{
					"begin": "(?i)^ {0,4}([*+]?)(f\\d+)(:[[:alpha:]]+(?:,[[:alpha:]]+)*)",
					"end": "\n",
					"contentName": "meta.card.tally.mcnp",
					"beginCaptures": {
						"1": {
							"name": "keyword.operator.modifier.mcnp"
						},
						"2": {
							"name": "keyword.control.tally.mcnp"
						},
						"3": {
							"name": "entity.name.tag.particle.mcnp"
						}
					},
					"patterns": [
						{
							"include": "#card_body"
						}
					]
				}
			]
		},
		"tally_modifier": {
			"patterns": [
				{
					"begin": "(?i)^ {0,4}([*+]?)(fs|sd|fm|de|df|em|tm|cm|fq|fu|tf|dd|nt|ft|[etc])(\\d+)(:[[:alpha:]]+(?:,[[:alpha:]]+)*)?(?![[:alnum:]])",
					"end": "\n",
					"contentName": "meta.card.tally.modifier.mcnp",
					"beginCaptures": {
						"1": {
							"name": "keyword.operator.modifier.mcnp"
						},
						"2": {
							"name": "keyword.control.tally.mcnp"
						},
						"3": {
							"name": "entity.name.function.tally.mcnp"
						},
						"4": {
							"name": "entity.name.tag.particle.mcnp"
						}
					},
					"patterns": [
						{
							"include": "#card_body"
						}
					]
				}
			]
		},
		"problem_data_card": {
			"patterns": [
				{
					"begin": "(?i)^ {0,4}(mode|cut|elpt|notrn|nps|ctme|stop|print|prdmp|lost|dbcn|files|rand|talnp|mplot|histp|idum|rdum|thtme|tropt|unc)(:[[:alpha:]]+(?:,[[:alpha:]]+)*)?(?![[:alnum:]])",
					"end": "\n",
					"contentName": "meta.card.problem.mcnp",
					"beginCaptures": {
						"1": {
							"name": "keyword.control.problem.mcnp"
						},
						"2": {
							"name": "entity.name.tag.particle.mcnp"
						}
					},
					"patterns": [
						{
							"include": "#card_body"
						}
					]
				}
			]
		},
		"variance_reduction_data_card": {
			"patterns": [
				{
					"begin": "(?i)^ {0,4}(imp|esplt|tsplt|ext|fcl|wwe|wwn|wwp|wwge|wwgt|dxt)(:[[:alpha:]]+(?:,[[:alpha:]]+)*)",
					"end": "\n",
					"contentName": "meta.card.variance.mcnp",
					"beginCaptures": {
						"1": {
							"name": "keyword.control.variance.mcnp"
						},
						"2": {
							"name": "entity.name.tag.particle.mcnp"
						}
					},
					"patterns": [
						{
							"include": "#card_body"
						}
					]
				},
				{
					"begin": "(?i)^ {0,4}(var|pwt|vect|wwg|mesh|spdtl)(?![[:alnum:]])",
					"end": "\n",
					"contentName": "meta.card.variance.mcnp",
					"beginCaptures": {
						"1": {
							"name": "keyword.control.variance.mcnp"
						}
					},
					"patterns": [
						{
							"include": "#card_body"
						}
					]
				},
				{
					"begin": "(?i)^ {0,4}(pd)(\\d+)(?![[:alnum:]])",
					"end": "\n",
					"contentName": "meta.card.variance.mcnp",
					"beginCaptures": {
						"1": {
							"name": "keyword.control.variance.mcnp"
						},
						"2": {
							"name": "entity.name.function.detector.mcnp"
						}
					},
					"patterns": [
						{
							"include": "#card_body"
						}
					]
				},
				{
					"begin": "(?i)^ {0,4}(dxc)(\\d+)(:[[:alpha:]]+(?:,[[:alpha:]]+)*)",
					"end": "\n",
					"contentName": "meta.card.variance.mcnp",
					"beginCaptures": {
						"1": {
							"name": "keyword.control.variance.mcnp"
						},
						"2": {
							"name": "entity.name.function.detector.mcnp"
						},
						"3": {
							"name": "entity.name.tag.particle.mcnp"
						}
					},
					"patterns": [
						{
							"include": "#card_body"
						}
					]
				}
			]
		},
		"geometry_data_card": {
			"patterns": [
				{
					"begin": "(?i)^ {0,4}([*]?)(tr)(\\d+)(?![[:alnum:]])",
					"end": "\n",
					"contentName": "meta.card.geometry.mcnp",
					"beginCaptures": {
						"1": {
							"name": "keyword.operator.modifier.mcnp"
						},
						"2": {
							"name": "keyword.control.geometry.mcnp"
						},
						"3": {
							"name": "entity.name.function.transform.mcnp"
						}
					},
					"patterns": [
						{
							"include": "#card_body"
						}
					]
				},
				{
					"begin": "(?i)^ {0,4}(vol|area|uran|dm|embed\\d*|lat|fill|u)(?![[:alnum:]])",
					"end": "\n",
					"contentName": "meta.card.geometry.mcnp",
					"beginCaptures": {
						"1": {
							"name": "keyword.control.geometry.mcnp"
						}
					},
					"patterns": [
						{
							"include": "#card_body"
						}
					]
				}
			]
		},
		"generic_data_card": {
			"patterns": [
				{
					"begin": "(?i)^ {0,4}([*+]?)([[:alpha:]][[:alnum:]]*)(:[[:alpha:]]+(?:,[[:alpha:]]+)*)?",
					"end": "\n",
					"contentName": "meta.card.data.mcnp",
					"beginCaptures": {
						"1": {
							"name": "keyword.operator.modifier.mcnp"
						},
						"2": {
							"name": "keyword.control.data.mcnp"
						},
						"3": {
							"name": "entity.name.tag.particle.mcnp"
						}
					},
					"patterns": [
						{
							"include": "#card_body"
						}
					]
				}
			]
		},
		"inline_comment": {
			"patterns": [
				{
					"name": "comment.line.dollar.mcnp",
					"match": "\\$.*$"
				}
			]
		},
		"continuation": {
			"patterns": [
				{
					"match": "(&)(.*)$",
					"captures": {
						"1": {
							"name": "keyword.operator.continuation.mcnp"
						},
						"2": {
							"name": "comment.line.ampersand.mcnp"
						}
					}
				}
			]
		},
		"geometry_operator": {
			"patterns": [
				{
					"name": "keyword.operator.geometry.mcnp",
					"match": "[#()]|(?<![[:alpha:]]):(?![[:alpha:]])"
				}
			]
		},
		"distribution": {
			"patterns": [
				{
					"match": "(?<![[:alnum:].])([-+]?)([dD]\\d+)(?![[:alnum:].])",
					"captures": {
						"1": {
							"name": "keyword.operator.mcnp"
						},
						"2": {
							"name": "variable.other.distribution.mcnp"
						}
					}
				}
			]
		},
		"shorthand": {
			"patterns": [
				{
					"name": "keyword.other.shorthand.mcnp",
					"match": "(?i)(?<![[:alnum:].])(?:[-+]?(?:\\d+\\.?\\d*|\\.\\d+)(?:[eE][-+]?\\d+)?(?:ilog|[rimj])|j)(?![[:alnum:].])"
				}
			]
		},
		"number": {
			"patterns": [
				{
					"name": "constant.numeric.mcnp",
					"match": "(?<![[:alnum:].])[-+]?(?:\\d+\\.?\\d*|\\.\\d+)(?:[eE][-+]?\\d+)?(?![[:alnum:].])"
				}
			]
		},
		"nuclide_library": {
			"patterns": [
				{
					"match": "(?<![[:alnum:].])([[:alnum:]]+)(\\.\\d{2,3}[a-zA-Z])(?![[:alnum:].+-])",
					"captures": {
						"1": {
							"name": "constant.other.zaid.mcnp"
						},
						"2": {
							"name": "constant.other.library.mcnp"
						}
					}
				}
			]
		},
		"argument": {
			"patterns": [
				{
					"match": "(?<![=:[:alnum:].])([[:alpha:]]+(?::[[:alpha:]]+(?:,[[:alpha:]]+)*)?)\\b=?",
					"captures": {
						"1": {
							"name": "variable.parameter.mcnp"
						}
					}
				}
			]
		}
	}
}
