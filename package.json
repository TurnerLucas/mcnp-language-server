{
	"name": "mcnp-language-server",
	"displayName": "MCNP Support",
	"description": "Language support for MCNP input files: syntax highlighting and input validation.",
	"version": "0.1.0",
	"license": "MIT",
	"author": "Ryan Pease",
	"publisher": "REPLACE-WITH-YOUR-PUBLISHER-ID",
	"repository": {
		"type": "git",
		"url": "https://github.com/REPLACE-WITH-YOUR-USERNAME/mcnp-language-server"
	},
	"icon": "client/images/physics-nuclear-pngrepo-com.png",
	"categories": [
		"Programming Languages",
		"Linters"
	],
	"keywords": [
		"MCNP",
		"MCNP6",
		"Monte Carlo",
		"Monte Carlo N-Particle",
		"neutronics",
		"radiation transport"
	],
	"engines": {
		"vscode": "^1.75.0"
	},
	"activationEvents": [
		"onLanguage:mcnp"
	],
	"main": "./client/out/extension",
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": true
		}
	},
	"contributes": {
		"configuration": {
			"type": "object",
			"title": "MCNP",
			"properties": {
				"mcnp.maxNumberOfProblems": {
					"scope": "resource",
					"type": "number",
					"default": 500,
					"description": "Maximum number of problems reported per MCNP input file."
				},
				"mcnp.trace.server": {
					"scope": "window",
					"type": "string",
					"enum": [
						"off",
						"messages",
						"verbose"
					],
					"default": "off",
					"description": "Trace the communication between VS Code and the MCNP language server."
				}
			}
		},
		"languages": [
			{
				"id": "mcnp",
				"aliases": [
					"MCNP",
					"Monte Carlo N-Particle"
				],
				"extensions": [
					".mcnp",
					".mcnpi",
					".imcnp",
					".inp",
					".i"
				],
				"configuration": "./client/syntax/language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "mcnp",
				"scopeName": "source.mcnp",
				"path": "./client/syntax/mcnp.tmLanguage.json"
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -b",
		"watch": "tsc -b -w",
		"clean": "tsc -b --clean",
		"postinstall": "cd client && npm install && cd ../server && npm install && cd ..",
		"test": "mocha --require ts-node/register \"server/test/**/*.test.ts\"",
		"package": "vsce package"
	},
	"devDependencies": {
		"@types/chai": "^4.3.16",
		"@types/mocha": "^10.0.6",
		"@types/node": "^20.12.12",
		"@types/vscode": "^1.75.0",
		"@vscode/vsce": "^2.26.1",
		"chai": "^4.4.1",
		"mocha": "^10.4.0",
		"ts-node": "^10.9.2",
		"typescript": "^5.4.5"
	}
}
