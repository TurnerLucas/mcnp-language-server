{
	"name": "mcnp-language-server",
	"displayName": "MCNP Support",
	"description": "Language support for MCNP input files: syntax highlighting and input validation.",
	"version": "0.1.0",
	"license": "MIT",
	"author": "Ryan Pease",
	"publisher": "REPLACE-WITH-YOUR-PUBLISHER-ID",
	"repository": {
		"type": "git",
		"url": "https://github.com/REPLACE-WITH-YOUR-USERNAME/mcnp-language-server"
	},
	"icon": "client/images/physics-nuclear-pngrepo-com.png",
	"categories": [
		"Programming Languages",
		"Linters"
	],
	"keywords": [
		"MCNP",
		"MCNP6",
		"Monte Carlo",
		"Monte Carlo N-Particle",
		"neutronics",
		"radiation transport"
	],
	"engines": {
		"vscode": "^1.75.0"
	},
	"activationEvents": [
		"onLanguage:mcnp"
	],
	"main": "./client/out/extension",
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": true
		}
	},
	"contributes": {
		"configuration": {
			"type": "object",
			"title": "MCNP",
			"properties": {
				"mcnp.maxNumberOfProblems": {
					"scope": "resource",
					"type": "number",
					"default": 500,
					"description": "Maximum number of problems reported per MCNP input file."
				},
				"mcnp.trace.server": {
					"scope": "window",
					"type": "string",
					"enum": [
						"off",
						"messages",
						"verbose"
					],
					"default": "off",
					"description": "Trace the communication between VS Code and the MCNP language server."
				}
			}
		},
		"configurationDefaults": {
			"[mcnp]": {
				"editor.detectIndentation": false,
				"editor.tabSize": 8,
				"editor.insertSpaces": true,
				"editor.rulers": [
					80
				],
				"editor.renderWhitespace": "boundary",
				"editor.tokenColorCustomizations": {
					"textMateRules": [
						{
							"scope": "comment.line.c.mcnp",
							"settings": {
								"foreground": "#6A9955",
								"fontStyle": "italic"
							}
						},
						{
							"scope": [
								"comment.line.dollar.mcnp",
								"comment.line.ampersand.mcnp"
							],
							"settings": {
								"foreground": "#5A8A4A",
								"fontStyle": "italic"
							}
						},
						{
							"scope": "entity.name.section.title.mcnp",
							"settings": {
								"foreground": "#DCDCAA",
								"fontStyle": "bold"
							}
						},
						{
							"scope": [
								"entity.name.function.cell.mcnp",
								"entity.name.function.surface.mcnp"
							],
							"settings": {
								"foreground": "#4FC1FF",
								"fontStyle": "bold"
							}
						},
						{
							"scope": [
								"entity.name.type.material.mcnp",
								"entity.name.type.transform.mcnp"
							],
							"settings": {
								"foreground": "#4EC9B0"
							}
						},
						{
							"scope": "constant.numeric.density.mcnp",
							"settings": {
								"foreground": "#B5CEA8",
								"fontStyle": "italic"
							}
						},
						{
							"scope": "support.function.surface.mcnp",
							"settings": {
								"foreground": "#DCDCAA",
								"fontStyle": "bold"
							}
						},
						{
							"scope": "keyword.control.source.mcnp",
							"settings": {
								"foreground": "#CE9178"
							}
						},
						{
							"scope": "keyword.control.material.mcnp",
							"settings": {
								"foreground": "#C586C0"
							}
						},
						{
							"scope": "keyword.control.tally.mcnp",
							"settings": {
								"foreground": "#569CD6"
							}
						},
						{
							"scope": "keyword.control.problem.mcnp",
							"settings": {
								"foreground": "#D16969"
							}
						},
						{
							"scope": "keyword.control.variance.mcnp",
							"settings": {
								"foreground": "#D7BA7D"
							}
						},
						{
							"scope": "keyword.control.geometry.mcnp",
							"settings": {
								"foreground": "#9CDCFE"
							}
						},
						{
							"scope": [
								"keyword.control.data.mcnp",
								"keyword.control.void.mcnp"
							],
							"settings": {
								"foreground": "#C586C0"
							}
						},
						{
							"scope": [
								"entity.name.function.material.mcnp",
								"entity.name.function.tally.mcnp",
								"entity.name.function.distribution.mcnp",
								"entity.name.function.detector.mcnp",
								"entity.name.function.transform.mcnp"
							],
							"settings": {
								"foreground": "#4EC9B0"
							}
						},
						{
							"scope": "entity.name.tag.particle.mcnp",
							"settings": {
								"foreground": "#F09A5B",
								"fontStyle": "bold"
							}
						},
						{
							"scope": "variable.parameter.mcnp",
							"settings": {
								"foreground": "#9CDCFE"
							}
						},
						{
							"scope": "variable.other.distribution.mcnp",
							"settings": {
								"foreground": "#C8A0E0"
							}
						},
						{
							"scope": "constant.numeric.mcnp",
							"settings": {
								"foreground": "#B5CEA8"
							}
						},
						{
							"scope": "constant.other.zaid.mcnp",
							"settings": {
								"foreground": "#7FD6C0"
							}
						},
						{
							"scope": "constant.other.library.mcnp",
							"settings": {
								"foreground": "#4A9C88",
								"fontStyle": "italic"
							}
						},
						{
							"scope": "keyword.other.shorthand.mcnp",
							"settings": {
								"foreground": "#E5C07B",
								"fontStyle": "bold"
							}
						},
						{
							"scope": [
								"keyword.operator.geometry.mcnp",
								"keyword.operator.mcnp"
							],
							"settings": {
								"foreground": "#D4D4D4",
								"fontStyle": "bold"
							}
						},
						{
							"scope": "keyword.operator.modifier.mcnp",
							"settings": {
								"foreground": "#F44747",
								"fontStyle": "bold"
							}
						},
						{
							"scope": "keyword.operator.continuation.mcnp",
							"settings": {
								"foreground": "#F44747",
								"fontStyle": "bold"
							}
						}
					]
				}
			},
			"editor.tokenColorCustomizations": {
				"textMateRules": [
					{
						"scope": "comment.line.c.mcnp",
						"settings": {
							"foreground": "#6A9955",
							"fontStyle": "italic"
						}
					},
					{
						"scope": [
							"comment.line.dollar.mcnp",
							"comment.line.ampersand.mcnp"
						],
						"settings": {
							"foreground": "#5A8A4A",
							"fontStyle": "italic"
						}
					},
					{
						"scope": "entity.name.section.title.mcnp",
						"settings": {
							"foreground": "#DCDCAA",
							"fontStyle": "bold"
						}
					},
					{
						"scope": [
							"entity.name.function.cell.mcnp",
							"entity.name.function.surface.mcnp"
						],
						"settings": {
							"foreground": "#4FC1FF",
							"fontStyle": "bold"
						}
					},
					{
						"scope": [
							"entity.name.type.material.mcnp",
							"entity.name.type.transform.mcnp"
						],
						"settings": {
							"foreground": "#4EC9B0"
						}
					},
					{
						"scope": "constant.numeric.density.mcnp",
						"settings": {
							"foreground": "#B5CEA8",
							"fontStyle": "italic"
						}
					},
					{
						"scope": "support.function.surface.mcnp",
						"settings": {
							"foreground": "#DCDCAA",
							"fontStyle": "bold"
						}
					},
					{
						"scope": "keyword.control.source.mcnp",
						"settings": {
							"foreground": "#CE9178"
						}
					},
					{
						"scope": "keyword.control.material.mcnp",
						"settings": {
							"foreground": "#C586C0"
						}
					},
					{
						"scope": "keyword.control.tally.mcnp",
						"settings": {
							"foreground": "#569CD6"
						}
					},
					{
						"scope": "keyword.control.problem.mcnp",
						"settings": {
							"foreground": "#D16969"
						}
					},
					{
						"scope": "keyword.control.variance.mcnp",
						"settings": {
							"foreground": "#D7BA7D"
						}
					},
					{
						"scope": "keyword.control.geometry.mcnp",
						"settings": {
							"foreground": "#9CDCFE"
						}
					},
					{
						"scope": [
							"keyword.control.data.mcnp",
							"keyword.control.void.mcnp"
						],
						"settings": {
							"foreground": "#C586C0"
						}
					},
					{
						"scope": [
							"entity.name.function.material.mcnp",
							"entity.name.function.tally.mcnp",
							"entity.name.function.distribution.mcnp",
							"entity.name.function.detector.mcnp",
							"entity.name.function.transform.mcnp"
						],
						"settings": {
							"foreground": "#4EC9B0"
						}
					},
					{
						"scope": "entity.name.tag.particle.mcnp",
						"settings": {
							"foreground": "#F09A5B",
							"fontStyle": "bold"
						}
					},
					{
						"scope": "variable.parameter.mcnp",
						"settings": {
							"foreground": "#9CDCFE"
						}
					},
					{
						"scope": "variable.other.distribution.mcnp",
						"settings": {
							"foreground": "#C8A0E0"
						}
					},
					{
						"scope": "constant.numeric.mcnp",
						"settings": {
							"foreground": "#B5CEA8"
						}
					},
					{
						"scope": "constant.other.zaid.mcnp",
						"settings": {
							"foreground": "#7FD6C0"
						}
					},
					{
						"scope": "constant.other.library.mcnp",
						"settings": {
							"foreground": "#4A9C88",
							"fontStyle": "italic"
						}
					},
					{
						"scope": "keyword.other.shorthand.mcnp",
						"settings": {
							"foreground": "#E5C07B",
							"fontStyle": "bold"
						}
					},
					{
						"scope": [
							"keyword.operator.geometry.mcnp",
							"keyword.operator.mcnp"
						],
						"settings": {
							"foreground": "#D4D4D4",
							"fontStyle": "bold"
						}
					},
					{
						"scope": "keyword.operator.modifier.mcnp",
						"settings": {
							"foreground": "#F44747",
							"fontStyle": "bold"
						}
					},
					{
						"scope": "keyword.operator.continuation.mcnp",
						"settings": {
							"foreground": "#F44747",
							"fontStyle": "bold"
						}
					}
				]
			}
		},
		"languages": [
			{
				"id": "mcnp",
				"aliases": [
					"MCNP",
					"Monte Carlo N-Particle"
				],
				"extensions": [
					".mcnp",
					".mcnpi",
					".imcnp",
					".inp",
					".i"
				],
				"configuration": "./client/syntax/language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "mcnp",
				"scopeName": "source.mcnp",
				"path": "./client/syntax/mcnp.tmLanguage.json"
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -b",
		"watch": "tsc -b -w",
		"clean": "tsc -b --clean",
		"postinstall": "cd client && npm install && cd ../server && npm install && cd ..",
		"test": "mocha --require ts-node/register \"server/test/**/*.test.ts\"",
		"package": "vsce package"
	},
	"devDependencies": {
		"@types/chai": "^4.3.16",
		"@types/mocha": "^10.0.6",
		"@types/node": "^20.12.12",
		"@types/vscode": "^1.75.0",
		"@vscode/vsce": "^2.26.1",
		"chai": "^4.4.1",
		"mocha": "^10.4.0",
		"ts-node": "^10.9.2",
		"typescript": "^5.4.5"
	}
}
